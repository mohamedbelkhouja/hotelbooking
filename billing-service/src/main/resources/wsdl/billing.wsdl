<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="http://hotel.tn/billing"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="http://hotel.tn/billing"
                  name="BillingService">

    <wsdl:types>
        <xs:schema>
            <xs:import namespace="http://hotel.tn/billing" schemaLocation="../xsd/billing.xsd"/>
        </xs:schema>
    </wsdl:types>

    <wsdl:message name="generateInvoiceRequest">
        <wsdl:part name="parameters" element="tns:generateInvoiceRequest"/>
    </wsdl:message>
    <wsdl:message name="generateInvoiceResponse">
        <wsdl:part name="parameters" element="tns:generateInvoiceResponse"/>
    </wsdl:message>
    <wsdl:message name="getInvoiceRequest">
        <wsdl:part name="parameters" element="tns:getInvoiceRequest"/>
    </wsdl:message>
    <wsdl:message name="getInvoiceResponse">
        <wsdl:part name="parameters" element="tns:getInvoiceResponse"/>
    </wsdl:message>
    <wsdl:message name="ReservationNotFoundFault">
        <wsdl:part name="fault" element="tns:ReservationNotFoundFault"/>
    </wsdl:message>

    <wsdl:portType name="BillingPort">
        <wsdl:operation name="generateInvoice">
            <wsdl:input message="tns:generateInvoiceRequest"/>
            <wsdl:output message="tns:generateInvoiceResponse"/>
            <wsdl:fault name="ReservationNotFoundFault" message="tns:ReservationNotFoundFault"/>
        </wsdl:operation>
        <wsdl:operation name="getInvoice">
            <wsdl:input message="tns:getInvoiceRequest"/>
            <wsdl:output message="tns:getInvoiceResponse"/>
            <wsdl:fault name="ReservationNotFoundFault" message="tns:ReservationNotFoundFault"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="BillingPortSoap11" type="tns:BillingPort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="generateInvoice">
            <soap:operation soapAction=""/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
            <wsdl:fault name="ReservationNotFoundFault">
                <soap:fault name="ReservationNotFoundFault" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="getInvoice">
            <soap:operation soapAction=""/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
            <wsdl:fault name="ReservationNotFoundFault">
                <soap:fault name="ReservationNotFoundFault" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="BillingPortService">
        <wsdl:port name="BillingPortSoap11" binding="tns:BillingPortSoap11">
            <soap:address location="http://localhost:8083/ws"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
